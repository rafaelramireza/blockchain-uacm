# =================================================================
# .gitignore — Prototipo MED-EC / Hyperledger Fabric UACM
# =================================================================

# --- Seguridad: identidades y material criptográfico sensible ---
**/*_sk
**/msp/keystore/*
**/users/*/msp/keystore/*
**/organizations/peerOrganizations/**/*.key
**/organizations/ordererOrganizations/**/*.key
*.pem
*.crt
*.cert
*.key
*.jks

# --- Artefactos generados por Hyperledger Fabric ---
organizations/peerOrganizations/
organizations/ordererOrganizations/
channel-artifacts/
system-genesis-block/
**/config_block.json
**/config_block.pb

# --- Dependencias, compilación y binarios ---
bin/
*.exe
*.dll
*.so
*.dylib
*.test
__debug_bin
vendor/
**/vendor/

# --- Docker, datos persistentes y logs locales ---
docker/volumes/
**/couchdb_data/
*.log
docker-compose.yaml.bak
docker-compose.yaml.bak.*
*.bak
*.tmp

# --- Node.js / Hyperledger Caliper ---
node_modules/
**/networktests/reports/
**/benchmarks/*/results/
caliper-log.txt

# --- Configuración local y editores ---
.env
.env.*
*.env
.vscode/
.history/

# --- Respaldos locales y metadatos del sistema ---
backup-medec-antes-cambio/
.DS_Store
Thumbs.db
*:Zone.Identifier

# Nota: no se ignoran CSV, reportes de pruebas ni package-lock.json de forma global.
# Los datos y resultados experimentales versionados deben conservarse para trazabilidad.
